<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MeuBlog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.38.0" />
  </ItemGroup>

  <!-- The .md posts are copied together with the app (build and publish) -->
  <ItemGroup>
    <Content Include="Content\Posts\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\img\posts\Database\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="wwwroot\img\posts\Database\PostgreSQL\QueryTool.png" />
    <None Include="wwwroot\img\posts\Database\PostgreSQL\Rates.png" />
    <None Include="wwwroot\img\posts\Database\PostgreSQL\Users\BaseRoles.png" />
    <None Include="wwwroot\img\posts\Database\PostgreSQL\Users\CreateRole.png" />
    <None Include="wwwroot\img\posts\Database\PostgreSQL\Users\CreateUser.png" />
    <None Include="wwwroot\img\posts\End\HimawariFurutani-SQL.png" />
  </ItemGroup>

</Project>
